@startuml SmartClinic_Context

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title C4 - Умная поликлиника. Уровень 1

Person(patient, "Пациент", "Записывается на приём, просматривает медицинскую историю, получает результаты анализов и оплачивает услуги.")
Person(doctor, "Врач", "Просматривает расписание и медицинские карты, ведёт приём, назначает анализы и направления.")
Person(admin, "Администратор ресепшена", "Регистрирует пациентов, управляет расписанием врачей и оформляет страховые документы.")

System(clinic, "Умная поликлиника", "Информационная система сети клиник МедЛайф. Обеспечивает запись на приём, ведение электронных медицинских карт, обработку анализов, платежей и взаимодействие с внешними системами.")

System_Ext(kdl, "Лаборатория КДЛ", "Внешняя лабораторная система. Принимает заказы на исследования и передаёт результаты через REST API.")
System_Ext(sogaz, "Страховая компания СОГАЗ", "Проверяет медицинские полисы и принимает реестры оказанных медицинских услуг.")
System_Ext(paymed, "Платёжный шлюз PayMed", "Обрабатывает онлайн-платежи и возвращает информацию о статусе транзакций.")
System_Ext(notification, "СМС / Email-шлюз", "Обеспечивает отправку SMS и электронных писем пациентам.")

Rel(patient, clinic, "Запись на приём, просмотр истории и результатов анализов, оплата услуг, получение уведомлений", "HTTPS / Web, Mobile API")
Rel(doctor, clinic, "Просмотр расписания и ЭМК, оформление приёмов, назначение анализов и направлений", "HTTPS")
Rel(admin, clinic, "Регистрация пациентов, управление расписанием, оформление страховых документов", "HTTPS")

Rel(clinic, kdl, "Передача заказов на анализы; получение результатов исследований", "REST API / HTTPS / JSON")
Rel(clinic, sogaz, "Проверка полисов; отправка реестров оказанных услуг", "REST API / HTTPS / JSON")
Rel(clinic, paymed, "Создание платежей и получение статусов транзакций", "REST API / HTTPS")
Rel(clinic, notification, "Передача данных для отправки SMS и Email-уведомлений", "REST API / HTTPS")

legend bottom
    |= Обозначение |
    |<#08427B>  Пользователь системы (Person) |
    |<#1168BD>  Проектируемая информационная система (System) |
    |<#999999>  Внешняя система (System_Ext) |
endlegend

@enduml